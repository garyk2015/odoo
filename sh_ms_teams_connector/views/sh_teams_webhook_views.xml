<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sh_teams_webhook_tree" model="ir.ui.view">
        <field name="name">sh.teams.webhook.tree</field>
        <field name="model">sh.teams.webhook</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_sh_teams_webhook_form" model="ir.ui.view">
        <field name="name">sh.teams.webhook.form</field>
        <field name="model">sh.teams.webhook</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_test_webhook" type="object" string="Test Connection" class="oe_highlight"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="e.g., General Channel"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="webhook_url" widget="url"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sh_teams_webhook" model="ir.actions.act_window">
        <field name="name">Teams Webhooks</field>
        <field name="res_model">sh.teams.webhook</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
