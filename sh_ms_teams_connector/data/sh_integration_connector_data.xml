<?xml version="1.0" encoding="UTF-8"?>
<odoo>
<data noupdate="1">
    <record id="sh_ms_teams_connector_connector" model="sh.integration.connector">
        <field name="name">Odoo Microsoft Teams Connector</field>
        <field name="technical_name">sh_ms_teams_connector</field>
        <field name="sequence">10</field>
        <field name="color">9</field>
        <!-- Log -->
        <field name="log_model">sh.ms.teams.sync.log</field>
        <field name="log_date_field">create_date</field>
        <field name="log_state_field">status</field>
        <field name="log_error_value">error</field>
        <field name="log_message_field">message</field>
        <!-- Menu -->
        <field name="menu_name">Microsoft Teams</field>
        <field name="menu_sequence">10</field>
    </record>

</data>

<data noupdate="0">
    <!-- Trigger dynamic menu reparenting on every module upgrade to ensure Hub consistency -->
    <function model="sh.integration.connector" name="action_sync_menus_by_module">
        <value>sh_ms_teams_connector</value>
    </function>
</data>
</odoo>
